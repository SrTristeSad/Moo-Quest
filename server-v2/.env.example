# Configure in the aaPanel Node.js Project environment settings.
MOO_HOST=127.0.0.1
MOO_PORT=8100
MOO_PUBLIC_HTTPS=1
# Nginx must overwrite X-Real-IP with the actual remote address.
MOO_TRUST_PROXY=1
# Optional, use a different secured path with backups:
# MOO_DATA_DIR=/www/mooquest-private
# Authenticated update channel. Pin YOUR OWN PUBLIC key only.
# MOO_UPDATE_MANIFEST_URL=https://updates.example.com/manifest.json
# MOO_UPDATE_PUBLIC_KEY_FILE=/etc/mooquest/release-public.pem

# Required database services for Node server V2. Never commit real passwords.
# For docker compose, copy this file to .env and replace both passwords.
MOO_PG_PASSWORD=CHANGE_TO_LONG_RANDOM_POSTGRES_PASSWORD
MOO_REDIS_PASSWORD=CHANGE_TO_LONG_RANDOM_REDIS_PASSWORD
# Set these connection URLs in the aaPanel Node.js Project environment.
# Percent-encode special characters in connection URL passwords.
MOO_DATABASE_URL=postgresql://mooquest:CHANGE_TO_LONG_RANDOM_POSTGRES_PASSWORD@127.0.0.1:5432/mooquest
MOO_REDIS_URL=redis://:CHANGE_TO_LONG_RANDOM_REDIS_PASSWORD@127.0.0.1:6379/0
# Optional ONE-TIME import on first launch with an empty PostgreSQL database.
# Keep config.json safe, back up PostgreSQL, then disable after import.
# MOO_IMPORT_JSON=1

# Operational backups (PostgreSQL custom dump + SHA256 manifest).
# Defaults to MOO_DATA_DIR/backups or server-v2/var/backups.
# Use a PRIVATE directory outside the webroot and copy encrypted backups
# off-host. Never commit backup files containing player credentials.
# MOO_BACKUP_DIR=/www/mooquest-private/backups
# Restore is intentionally OFF by default and requires the Node app stopped.
# MOO_CONFIRM_RESTORE=RESTORE mooquest
# MOO_SERVER_STOPPED=YES

# Hardened PUBLIC guest ingress. Requires HTTPS terminating at your proxy.
# Turnstile response is checked server-side; captcha:true is NOT verification.
# The existing Lua client has no Turnstile UI yet: enabling this mode blocks
# guest joins until the client sends a real captchaToken from your site.
# MOO_PUBLIC_MODE=1
# MOO_PUBLIC_HTTPS=1
# MOO_TURNSTILE_SECRET=YOUR_PRIVATE_SERVER_SIDE_TURNSTILE_SECRET
# MOO_TURNSTILE_HOSTNAME=game.example.com
# MOO_TRUST_PROXY=1
