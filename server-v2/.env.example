# Configure in the aaPanel Node.js Project environment settings.
MOO_HOST=127.0.0.1
MOO_PORT=8100
MOO_PUBLIC_HTTPS=1
# Nginx must overwrite X-Real-IP with the actual remote address.
MOO_TRUST_PROXY=1
# Optional, use a different secured path with backups:
# MOO_DATA_DIR=/www/mooquest-private
# Authenticated update channel. Pin YOUR OWN PUBLIC key only.
# MOO_UPDATE_MANIFEST_URL=https://updates.example.com/manifest.json
# MOO_UPDATE_PUBLIC_KEY_FILE=/etc/mooquest/release-public.pem
